# Copy this file to .env and fill in your values.

# Anthropic API key (or another provider's key -- see agent/llm.py to swap providers)
LLM_API_KEY=your-api-key-here

# Model name passed to the provider SDK
LLM_MODEL=claude-sonnet-5

# Provider identifier: "anthropic" | "openai" | "ollama"
LLM_PROVIDER=anthropic

# Path to the DuckDB file used by the tools
DUCKDB_PATH=data/olist.duckdb
